# extract — environment variables. Everything is optional except PARSE_MODEL_URL.

# --- Parse model (required for parsing) ---
# Any endpoint implementing the /predict contract in serving/server.py.
# Self-host from the published weights: https://huggingface.co/hanji-dev/hanji-parse-4b
# (see serving/SELF_HOSTING.md), or point at a hosted deployment.
PARSE_MODEL_URL=
# Optional; sent as "Authorization: Api-Key <value>" (Baseten-style endpoints).
PARSE_MODEL_API_KEY=

# --- Schema extraction (required for /v1/extract/schema*) ---
# Either a plain Gemini API key ...
GEMINI_API_KEY=
# ... or a Vertex AI project (wins over GEMINI_API_KEY when set).
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# Optional inline service-account JSON; Application Default Credentials otherwise.
GOOGLE_VERTEX_SA_JSON=

# --- Optional quality enrichments (all fail open when unset) ---
# AWS credentials enable the Textract cross-engine read on handwriting-heavy
# pages during schema extraction (install the `aws` extra).
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=

# --- Server ---
# Comma-separated CORS origins ("" = no CORS headers).
CORS_ALLOWED_ORIGINS=
# Where extracted figure images go: "inline" (base64 in the response, default)
# or "local" (written to EXTRACT_LOCAL_STORAGE_DIR).
EXTRACT_STORAGE=inline

# --- Async batch lane (/v1/files, /v1/batches; optional) ---
# Requires the `batch` extra, Postgres, and an S3-compatible object store.
# Apply migrations with `python -m extract.migrate`; run the worker with
# `python -m extract.workers.batch_worker`. docker-compose provisions
# Postgres + MinIO with the values below (see docs/batch.md).
DATABASE_URL=
EXTRACT_UPLOADS_BUCKET=
EXTRACT_RESULTS_BUCKET=
# Custom S3 endpoint (MinIO etc.); leave unset for AWS.
EXTRACT_S3_ENDPOINT_URL=
# Endpoint presigned URLs are minted against, when clients reach the store on
# a different host than the API/worker do (compose: http://localhost:9100).
EXTRACT_S3_PUBLIC_ENDPOINT_URL=
# Webhooks: registered endpoints are managed with `python -m extract.webhooks`.
# Allow http:// / private-network webhook destinations (self-host escape
# hatch; leave off when endpoint URLs come from untrusted users).
EXTRACT_WEBHOOK_ALLOW_PRIVATE_URLS=
